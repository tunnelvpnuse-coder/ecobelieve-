{
  "name": "omni-life",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @omni-life/db exec prisma generate",
    "db:migrate": "pnpm --filter @omni-life/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @omni-life/db exec tsx seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
